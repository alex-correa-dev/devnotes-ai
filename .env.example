# --- MongoDB ---
MONGODB_URI=mongodb://admin:admin@localhost:27017/devnotes?authSource=admin&directConnection=true
MONGODB_DB_NAME=devnotes

# --- API ---
API_PORT=4000
NODE_ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# --- CORS ---
CORS_ORIGIN=http://localhost:3000